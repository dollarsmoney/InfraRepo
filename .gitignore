# Never commit cluster credentials or rendered secrets
kubeconfig
*.kubeconfig
.env
.env.*
*-secret.yaml
secrets.yaml

# Terraform. State holds the cluster CA and the deploy ServiceAccount tokens.
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Helm's vendored dependencies only. Must stay anchored: a bare "charts/"
# would also swallow terraform/charts/, which is real source.
/helm/marketplace/charts/
*.tgz

# Saved plan files can embed resource values
tfplan
*.tfplan

.DS_Store
